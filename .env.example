# .env.example — copy to .env and fill in values
# All variables have defaults; only set what you need to override.

# --- LLM Backend ---
# LLM_BACKEND=ollama          # "ollama" (default) or "claude" (not yet implemented)

# --- Ollama settings (when LLM_BACKEND=ollama) ---
# OLLAMA_HOST=http://host.docker.internal:11434   # Ollama URL reachable from containers
# MODEL_NAME=qwen2.5-coder:7b                     # Model to use for all agents
# OLLAMA_TIMEOUT=600                              # Per-call timeout in seconds

# --- Claude API settings (when LLM_BACKEND=claude — not yet implemented) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Coordinator ---
# COORDINATOR_PORT=8000        # Host port for the coordinator API
# SHARED_VOLUME=/work/shared   # Path inside containers to the shared volume
